---
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: object | object[];
  whatsappMessage?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  type,
  noindex,
  jsonLd,
  whatsappMessage,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/png" href="/images/logo.png" />

  <SEOHead
    title={title}
    description={description}
    canonical={canonical}
    ogImage={ogImage}
    type={type}
    noindex={noindex}
    jsonLd={jsonLd}
  />

</head>
<body class="min-h-[100svh] flex flex-col">
  <Header message={whatsappMessage} />
  <CookieConsent />

  <main class="flex-1">
    <slot />
  </main>

  <Footer />

</body>
</html>

<script>
  const motionItems = document.querySelectorAll(
    '.motion-item, main section h2, main section .service-row, main section .testimonial-item, main section figure'
  );
  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const motionObserver = new IntersectionObserver((entries, observer) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          entry.target.classList.remove('is-entering');
          observer.unobserve(entry.target);
        }
      }
    }, { threshold: 0.12 });
    motionItems.forEach((item) => {
      item.classList.add('motion-item');
      item.classList.add('is-entering');
      motionObserver.observe(item);
    });
  }
</script>
