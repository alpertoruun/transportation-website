---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  updatedAt?: string;
}

const { title, description, heading, updatedAt = '3 Ağustos 2026' } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="max-w-7xl mx-auto px-4">
    <Breadcrumb items={[
      { label: 'Ana Sayfa', href: '/' },
      { label: heading },
    ]} />
  </div>

  <section class="bg-primary-800 py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4">
      <p class="text-accent-300 text-sm font-semibold uppercase tracking-wider mb-3">Yasal Bilgilendirme</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white">{heading}</h1>
      <p class="text-gray-300 mt-3">Son güncelleme: {updatedAt}</p>
    </div>
  </section>

  <article class="section-padding bg-white">
    <div class="legal-content max-w-4xl mx-auto">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .legal-content :global(h2) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: rgb(30 64 175);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .legal-content :global(h3) {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: rgb(30 64 175);
    font-size: 1.125rem;
    font-weight: 700;
  }

  .legal-content :global(p),
  .legal-content :global(li) {
    color: rgb(75 85 99);
    line-height: 1.75;
  }

  .legal-content :global(p),
  .legal-content :global(ul) {
    margin-bottom: 1rem;
  }

  .legal-content :global(ul) {
    list-style: disc;
    padding-left: 1.5rem;
  }

  .legal-content :global(a) {
    color: rgb(234 88 12);
    text-decoration: underline;
  }

  .legal-content :global(.notice) {
    padding: 1rem 1.25rem;
    border: 1px solid rgb(253 186 116);
    border-radius: 0.75rem;
    background: rgb(255 247 237);
  }
</style>
