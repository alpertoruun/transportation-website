---
const stats = [
  { value: '81', label: 'İlde Hizmet', suffix: '' },
  { value: '10000', label: 'Mutlu Müşteri', suffix: '+' },
  { value: '7/24', label: 'WhatsApp Destek', suffix: '' },
  { value: '100', label: 'Sigorta Kapsamı', suffix: '%' },
];
---

<section class="stats-section" aria-labelledby="stats-heading">
  <div class="stats-inner">
    <div class="stats-copy">
      <h2 id="stats-heading">Türkiye'nin 81 İlinde Hizmet</h2>
      <dl class="stats-list">
        {stats.map((stat) => (
          <div class="stats-row">
            <dt>{stat.label}</dt>
            <dd>{stat.value}{stat.suffix}</dd>
          </div>
        ))}
      </dl>
    </div>
    <figure class="stats-photo motion-item">
      <img src="/images/arac/nakliyat-araci-02.jpeg" alt="Leventoğlu Nakliyat taşıma aracı" width="1600" height="1067" loading="lazy" />
    </figure>
  </div>
</section>

<style>
  .stats-section {
    padding: clamp(5rem, 10vw, 9rem) var(--page-margin);
    background: var(--paper);
  }

  .stats-inner {
    max-width: 1760px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
    align-items: center;
    gap: clamp(2rem, 8vw, 8rem);
  }

  .stats-copy { grid-column: 1; }

  h2 {
    max-width: 17ch;
    margin: 0 0 2rem;
    color: var(--ink);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 650;
  }

  .stats-list { margin: 0; }

  .stats-row {
    display: grid;
    grid-template-columns: minmax(7rem, 0.4fr) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: baseline;
    padding-block: 1.1rem;
  }

  .stats-row + .stats-row { margin-top: 0.25rem; }

  .stats-row dt {
    grid-column: 2;
    color: var(--ink-soft);
    font-size: 17px;
    line-height: 1.35;
  }

  .stats-row dd {
    grid-column: 1;
    grid-row: 1;
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.04em;
  }

  .stats-photo {
    grid-column: 2;
    grid-row: 1;
    width: 100%;
    aspect-ratio: 1 / 1;
    margin: 2rem 0 0;
    overflow: hidden;
  }

  .stats-photo img { width: 100%; height: 100%; display: block; object-fit: cover; object-position: 52% 54%; }

  @media (max-width: 720px) {
    .stats-inner { grid-template-columns: minmax(0,1fr); gap: 2.5rem; }
    .stats-photo { grid-column: 1; grid-row: 2; width: min(62%, 22rem); justify-self: end; margin-top: 0; }
    .stats-row { grid-template-columns: 6.5rem minmax(0,1fr); gap: 1rem; padding-block: 0.75rem; }
    .stats-row dt { font-size: 16px; }
  }
</style>
