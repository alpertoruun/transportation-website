---
import { testimonials } from '../data/testimonials';

const displayedTestimonials = testimonials.slice(0, 6);
---

<section class="testimonial-section" id="yorumlar" aria-labelledby="testimonials-heading">
  <div class="testimonial-inner">
    <div class="testimonial-intro">
      <h2 id="testimonials-heading">Müşterilerimiz Ne Diyor?</h2>
      <p>Binlerce mutlu müşterimizden bazılarının yorumları.</p>
    </div>
    <div class="testimonial-list">
      {displayedTestimonials.map((t) => (
        <figure class="testimonial-item">
          <div class="testimonial-stars" aria-label={`${t.rating} yıldız`}>
            {Array.from({ length: t.rating }).map(() => (
              <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69z" />
              </svg>
            ))}
          </div>
          <blockquote>“{t.comment}”</blockquote>
          <figcaption>
            <span class="testimonial-name">{t.name}</span>
            <span class="testimonial-attribution">{t.title} {t.route && `• ${t.route}`}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonial-section {
    padding: clamp(5rem, 10vw, 9rem) var(--page-margin);
    background: var(--paper-soft);
    color: var(--ink);
  }

  .testimonial-inner { max-width: 1760px; margin-inline: auto; }

  .testimonial-intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    padding-right: 6rem;
    margin-bottom: clamp(2.75rem, 6vw, 5rem);
  }

  .testimonial-intro h2 {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2rem, 4.4vw, 4rem);
  }

  .testimonial-intro p { max-width: 35ch; margin: 0; color: var(--ink-soft); font-size: 17px; }

  .testimonial-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(2rem, 7vw, 7rem);
    row-gap: clamp(2.5rem, 5vw, 4.5rem);
  }

  .testimonial-item { margin: 0; }

  .testimonial-stars { display: flex; gap: 0.2rem; margin-bottom: 1rem; color: #a66500; }
  .testimonial-stars svg { width: 17px; height: 17px; }

  .testimonial-item blockquote {
    margin: 0 0 1.4rem;
    color: var(--ink);
    font-size: clamp(1.1rem, 1.55vw, 1.4rem);
    font-weight: 450;
    line-height: 1.45;
    letter-spacing: -0.015em;
  }

  .testimonial-item figcaption { display: flex; flex-direction: column; gap: 0.15rem; }
  .testimonial-name { color: var(--ink); font-size: 16px; font-weight: 650; }
  .testimonial-attribution { color: var(--ink-soft); font-size: 14px; }

  @media (max-width: 760px) {
    .testimonial-intro { align-items: flex-start; flex-direction: column; gap: 0.75rem; }
    .testimonial-intro { padding-right: 5rem; }
    .testimonial-list { grid-template-columns: 1fr; row-gap: 2.75rem; }
  }
</style>
