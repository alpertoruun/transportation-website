---
import { siteConfig } from '../data/site';

const consentKey = 'leventoglu-consent-v1';
---

<aside
  id="cookie-consent"
  class="fixed inset-x-3 bottom-3 z-[100] hidden max-w-3xl rounded-2xl border border-gray-200 bg-white p-5 shadow-2xl md:left-1/2 md:right-auto md:w-[calc(100%-2rem)] md:-translate-x-1/2 md:p-6"
  aria-labelledby="cookie-title"
  aria-live="polite"
>
  <div>
    <h2 id="cookie-title" class="text-lg font-bold text-primary-900">Gizlilik tercihleriniz</h2>
    <p class="mt-2 text-sm leading-6 text-gray-600">
      Zorunlu olmayan reklam teknolojilerini ve Google haritasını yalnızca izninizle yüklüyoruz.
      Ayrıntılar için <a href="/cerez-politikasi/" class="font-medium text-accent-600 underline">Çerez Politikası</a>.
    </p>
  </div>

  <div id="cookie-preferences" class="mt-4 hidden rounded-xl bg-gray-50 p-4">
    <label class="flex cursor-pointer items-start justify-between gap-4 border-b border-gray-200 pb-3">
      <span>
        <span class="block text-sm font-semibold text-primary-900">Pazarlama ve ölçüm</span>
        <span class="mt-1 block text-xs leading-5 text-gray-600">Google Ads etiketinin reklam performansını ölçmesine izin verir.</span>
      </span>
      <input id="consent-marketing" type="checkbox" class="mt-1 h-5 w-5 rounded border-gray-300 text-accent-600 focus:ring-accent-500" />
    </label>
    <label class="flex cursor-pointer items-start justify-between gap-4 pt-3">
      <span>
        <span class="block text-sm font-semibold text-primary-900">Harici içerik</span>
        <span class="mt-1 block text-xs leading-5 text-gray-600">İletişim sayfasındaki Google Maps içeriğini yükler.</span>
      </span>
      <input id="consent-external" type="checkbox" class="mt-1 h-5 w-5 rounded border-gray-300 text-accent-600 focus:ring-accent-500" />
    </label>
    <button id="cookie-save" type="button" class="mt-4 w-full rounded-lg bg-primary-800 px-4 py-2.5 text-sm font-semibold text-white hover:bg-primary-700">Tercihlerimi Kaydet</button>
  </div>

  <div class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-3">
    <button id="cookie-accept" type="button" class="rounded-lg bg-primary-800 px-4 py-2.5 text-sm font-semibold text-white hover:bg-primary-700">Tümünü Kabul Et</button>
    <button id="cookie-reject" type="button" class="rounded-lg border border-primary-800 bg-white px-4 py-2.5 text-sm font-semibold text-primary-800 hover:bg-primary-50">İsteğe Bağlıları Reddet</button>
    <button id="cookie-manage" type="button" class="rounded-lg border border-primary-800 bg-white px-4 py-2.5 text-sm font-semibold text-primary-800 hover:bg-primary-50" aria-expanded="false">Tercihleri Yönet</button>
  </div>
</aside>

<script define:vars={{ consentKey, gtmId: siteConfig.gtmId, googleAdsId: siteConfig.googleAdsId }}>
  const panel = document.getElementById('cookie-consent');
  const preferences = document.getElementById('cookie-preferences');
  const marketingInput = document.getElementById('consent-marketing');
  const externalInput = document.getElementById('consent-external');
  const manageButton = document.getElementById('cookie-manage');
  let marketingLoaded = false;

  function readConsent() {
    try {
      const value = localStorage.getItem(consentKey);
      return value ? JSON.parse(value) : null;
    } catch {
      return null;
    }
  }

  function loadMarketing() {
    if (marketingLoaded) return;
    marketingLoaded = true;
    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
    window.gtag('js', new Date());

    if (googleAdsId && googleAdsId !== 'AW-XXXXXXXXXX') {
      const adsScript = document.createElement('script');
      adsScript.async = true;
      adsScript.src = `https://www.googletagmanager.com/gtag/js?id=${googleAdsId}`;
      document.head.appendChild(adsScript);
      window.gtag('config', googleAdsId);
    }

    if (gtmId && gtmId !== 'GTM-XXXXXXX') {
      window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      const gtmScript = document.createElement('script');
      gtmScript.async = true;
      gtmScript.src = `https://www.googletagmanager.com/gtm.js?id=${gtmId}`;
      document.head.appendChild(gtmScript);
    }
  }

  function applyConsent(choice) {
    if (choice?.marketing) loadMarketing();
    window.dispatchEvent(new CustomEvent('leventoglu:consent', { detail: choice }));
  }

  function saveConsent(marketing, external) {
    const choice = { version: 1, marketing, external, savedAt: new Date().toISOString() };
    try { localStorage.setItem(consentKey, JSON.stringify(choice)); } catch {}
    panel?.classList.add('hidden');
    applyConsent(choice);
  }

  const saved = readConsent();
  if (saved) applyConsent(saved);
  else panel?.classList.remove('hidden');

  document.getElementById('cookie-accept')?.addEventListener('click', () => saveConsent(true, true));
  document.getElementById('cookie-reject')?.addEventListener('click', () => saveConsent(false, false));
  document.getElementById('cookie-save')?.addEventListener('click', () => saveConsent(Boolean(marketingInput?.checked), Boolean(externalInput?.checked)));
  manageButton?.addEventListener('click', () => {
    const isOpen = !preferences?.classList.contains('hidden');
    preferences?.classList.toggle('hidden', isOpen);
    manageButton.setAttribute('aria-expanded', String(!isOpen));
  });

  document.querySelectorAll('[data-cookie-settings]').forEach((button) => {
    button.addEventListener('click', () => {
      const current = readConsent();
      if (marketingInput) marketingInput.checked = Boolean(current?.marketing);
      if (externalInput) externalInput.checked = Boolean(current?.external);
      panel?.classList.remove('hidden');
      preferences?.classList.remove('hidden');
      manageButton?.setAttribute('aria-expanded', 'true');
    });
  });
</script>
