---
import { siteConfig } from '../data/site';

const whatsappUrl = `https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent(siteConfig.whatsappDefault)}`;
---

<section class="hero-section" aria-labelledby="service-heading">
  <div class="hero-content">
    <div class="hero-wordmark" aria-label="Leventoğlu Nakliyat">
      <span>Leventoğlu</span><span>Nakliyat</span>
    </div>

    <div class="hero-copy">
      <div class="hero-message">
        <h1 class="hero-title-copy" id="service-heading">Güvenli ve Profesyonel Evden Eve Nakliyat</h1>
        <p class="hero-description">
          Leventoğlu Nakliyat ile eşyalarınız sigortalı ve özenle taşınır.
          Şehir içi, şehirler arası — nereye taşınırsanız taşının, yanınızdayız.
        </p>
      </div>
      <div class="hero-actions">
        <a href="/teklif-al/" class="btn-primary">
          Ücretsiz Teklif Al
        </a>
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="hero-whatsapp">
          WhatsApp ile Ulaşın
        </a>
      </div>
    </div>

    <figure class="hero-photo motion-item">
      <img
        src="/images/arac/nakliyat-araci-01.jpeg"
        alt="Leventoğlu Nakliyat aracı"
        width="1600"
        height="1067"
        loading="eager"
        fetchpriority="high"
      />
    </figure>

    <ul class="hero-assurances" aria-label="Hizmet bilgileri">
      <li>Sigortalı Taşıma</li>
      <li>Profesyonel Ekip</li>
      <li>Zamanında Teslimat</li>
    </ul>
  </div>
</section>

<style>
  .hero-section {
    padding: 32px var(--page-margin) clamp(2.5rem, 5vw, 4.5rem);
    background: var(--paper);
    color: var(--ink);
  }

  .hero-content {
    width: 100%;
    max-width: 1760px;
    margin-inline: auto;
  }

  .hero-wordmark {
    margin: 0 0 1.5rem;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    font-size: clamp(7rem, 12.2vw, 11rem);
    font-weight: 760;
    letter-spacing: -0.075em;
    line-height: 0.94;
    transform-origin: center;
    animation: wordmark-arrive 800ms cubic-bezier(.2,.7,.2,1) both;
  }

  .hero-wordmark span:last-child { align-self: flex-end; margin-right: 5rem; }

  .hero-copy {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.75rem);
  }

  .hero-message { max-width: 46rem; }

  .hero-title-copy {
    max-width: 26ch;
    margin: 0 0 0.55rem;
    color: var(--ink);
    font-size: clamp(2rem, 2.7vw, 2.25rem);
    font-weight: 650;
    line-height: 1.2;
  }

  .hero-description {
    max-width: 62ch;
    margin: 0;
    color: var(--ink-soft);
    font-size: 17px;
    line-height: 1.5;
  }

  .hero-actions {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 1.25rem;
  }

  .hero-whatsapp {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    color: var(--ink);
    font-size: 16px;
    font-weight: 650;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--accent);
    transition: color 180ms ease;
  }

  .hero-whatsapp:hover { color: #8e5700; }

  .hero-photo {
    width: 100%;
    height: clamp(18rem, 42vw, 35rem);
    margin: 0;
    overflow: hidden;
    background: var(--paper-soft);
  }

  .hero-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 65%;
    animation: photo-settle 1s ease-out both;
  }

  .hero-assurances {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.25rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--ink-soft);
    font-size: 15px;
  }

  @keyframes wordmark-arrive {
    from { opacity: 0.6; transform: scale(0.96); }
    to { opacity: 1; transform: scale(1); }
  }

  @keyframes photo-settle {
    from { transform: scale(1.035); }
    to { transform: scale(1); }
  }

  @media (max-width: 800px) {
    .hero-wordmark {
      font-size: clamp(3.5rem, 15vw, 7rem);
    }

    .hero-copy {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.1rem;
    }

    .hero-actions { flex-wrap: wrap; }
  }

  @media (max-width: 560px) {
    .hero-title-copy { font-size: 1.75rem; }
    .hero-section { padding-top: 24px; }
    .hero-wordmark { margin-bottom: 1rem; }
    .hero-photo { height: auto; aspect-ratio: 4 / 5; }
    .hero-actions { width: 100%; align-items: stretch; }
    .hero-actions .btn-primary { width: 100%; }
    .hero-whatsapp { justify-content: center; width: 100%; }
    .hero-assurances { gap: 0.5rem 1.25rem; font-size: 14px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-wordmark, .hero-photo img { animation: none; }
  }
</style>
