---
import { siteConfig } from '../data/site';

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = 'Taşınma Planınız mı Var?',
  subtitle = 'Hemen ücretsiz fiyat teklifi alın. WhatsApp üzerinden anında dönüş yapıyoruz.',
} = Astro.props;

const whatsappUrl = `https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent(siteConfig.whatsappDefault)}`;
---

<section class="closing-cta">
  <div class="closing-cta-inner">
    <div class="closing-cta-copy">
      <h2>{title}</h2>
      <p>{subtitle}</p>
    </div>
    <div class="closing-cta-actions">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="cta-whatsapp"
      >
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" /></svg>
        WhatsApp ile Fiyat Al
      </a>
      <a
        href={`tel:${siteConfig.phone}`}
        class="cta-phone"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
        {siteConfig.phoneDisplay}
      </a>
    </div>
  </div>
</section>

<style>
  .closing-cta { background: var(--accent); color: var(--ink); padding: clamp(3.5rem, 8vw, 7rem) var(--page-margin); }
  .closing-cta-inner { max-width: 1440px; margin: auto; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(18rem, .9fr); gap: 3rem; align-items: end; }
  .closing-cta h2 { max-width: 18ch; margin: 0 0 1rem; font-size: clamp(2rem, 4.6vw, 4.25rem); line-height: 1.02; letter-spacing: -.04em; }
  .closing-cta-copy > p:last-child { max-width: 60ch; margin: 0; font-size: 1.125rem; line-height: 1.55; }
  .closing-cta-actions { display: grid; gap: .75rem; }
  .cta-whatsapp, .cta-phone { display: flex; align-items: center; justify-content: center; gap: .75rem; min-height: 58px; padding: .9rem 1.1rem; font-weight: 700; text-decoration: none; }
  .cta-whatsapp { background: var(--ink); color: #fff; }
  .cta-phone { background: #ffd36f; color: var(--ink); }
  .cta-whatsapp:hover { background: #1b3a5c; }
  .cta-phone:hover { background: rgba(17,36,56,.08); }
  @media (max-width: 700px) { .closing-cta-inner { grid-template-columns: 1fr; gap: 2rem; } }
</style>
