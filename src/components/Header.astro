---
import { siteConfig } from '../data/site';

const navLinks = [
  { label: 'Ana Sayfa', href: '/' },
  { label: 'Hizmetlerimiz', href: '/hizmetlerimiz/' },
  { label: 'Hizmet Bölgelerimiz', href: '/hizmet-bolgelerimiz/' },
  { label: 'Hakkımızda', href: '/hakkimizda/' },
  { label: 'Galeri', href: '/galeri/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'İletişim', href: '/iletisim/' },
];

interface Props {
  message?: string;
}

const { message = siteConfig.whatsappDefault } = Astro.props;
const currentPath = Astro.url.pathname;
const whatsappUrl = `https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent(message)}`;
---

<header class="site-header">
  <div class="site-contact-bar">
    <div class="site-contact-inner">
      <div class="site-contact-links">
        <a href={`tel:${siteConfig.phone}`}>{siteConfig.phoneDisplay}</a>
        <a href={`tel:${siteConfig.phone2}`}>{siteConfig.phone2Display}</a>
        <span>{siteConfig.address.district}, {siteConfig.address.city}</span>
      </div>
      <span class="site-service-area">Türkiye'nin 81 İline Hizmet</span>
    </div>
  </div>

  <nav class="site-nav" aria-label="Ana gezinme">
    <a href="/" class="site-brand" aria-label={`${siteConfig.name} ana sayfa`}>
      <img src="/images/logo.png" alt="" width="54" height="54" loading="eager" />
      <span>Leventoğlu<br />Nakliyat</span>
    </a>

    <div id="desktop-links" class="desktop-links">
      {navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) ? 'page' : undefined}
          class:list={[
            'site-nav-link',
            currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) ? 'is-current' : '',
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="site-nav-actions">
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="site-whatsapp-link">WhatsApp</a>
      <a href="/teklif-al/" class="btn-primary site-offer-link">Teklif Al</a>
    </div>

    <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="mobile-whatsapp-link" aria-label="WhatsApp üzerinden iletişim kurun">
      WhatsApp
    </a>

    <button
      id="mobile-menu-btn"
      class="mobile-menu-button"
      type="button"
      aria-label="Menüyü aç"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <span></span><span></span>
    </button>

    <div id="mobile-menu" class="mobile-menu" hidden>
      {navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp</a>
      <a href="/teklif-al/">Teklif Al</a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    const isOpen = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(isOpen));
    btn.setAttribute('aria-label', isOpen ? 'Menüyü kapat' : 'Menüyü aç');
    if (menu) menu.hidden = !isOpen;
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    color: var(--ink);
    background: var(--paper);
  }

  .site-contact-bar {
    background: var(--ink);
    color: var(--paper);
  }

  .site-contact-inner,
  .site-nav {
    width: 100%;
    max-width: 1760px;
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .site-contact-inner {
    min-height: 38px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 14px;
  }

  .site-contact-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    column-gap: 1.5rem;
  }

  .site-contact-links a,
  .site-contact-inner a { text-decoration: none; }
  .site-service-area { color: #f7c65f; }

  .site-nav {
    min-height: 82px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    position: relative;
  }

  .site-brand {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    text-decoration: none;
  }

  .site-brand img { width: 48px; height: 48px; object-fit: cover; }

  .desktop-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.6rem, 1.2vw, 1.25rem);
  }

  .site-nav-link {
    color: var(--ink-soft);
    font-size: 14px;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav-link.is-current { color: #8e5700; }

  .site-nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: 0 0 auto;
  }

  .site-whatsapp-link {
    color: var(--ink);
    font-size: 15px;
    font-weight: 650;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 5px;
  }

  .site-offer-link { min-height: 44px; padding: 0.65rem 1rem; }

  .mobile-whatsapp-link,
  .mobile-menu-button,
  .mobile-menu { display: none; }

  @media (max-width: 1200px) {
    .site-nav { min-height: 72px; }
    .desktop-links, .site-nav-actions { display: none; }
    .mobile-whatsapp-link {
      min-width: 44px;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding-inline: .5rem;
      color: #155e45;
      font-size: 14px;
      font-weight: 700;
      text-decoration: underline;
      text-decoration-color: var(--accent);
      text-underline-offset: 4px;
    }
    .mobile-menu-button {
      width: 48px;
      height: 48px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 7px;
      border: 0;
      background: transparent;
      cursor: pointer;
    }
    .mobile-menu-button span {
      width: 25px;
      height: 2px;
      display: block;
      background: var(--ink);
      transition: transform 180ms ease;
    }
    .mobile-menu-button[aria-expanded="true"] span:first-child { transform: translateY(4.5px) rotate(45deg); }
    .mobile-menu-button[aria-expanded="true"] span:last-child { transform: translateY(-4.5px) rotate(-45deg); }
    .mobile-menu:not([hidden]) {
      position: absolute;
      inset: 100% var(--page-margin) auto;
      display: grid;
      gap: 0;
      padding: 0.5rem 1rem;
      background: var(--paper);
    }
    .mobile-menu a {
      padding: 0.9rem 0;
      color: var(--ink);
      font-size: 16px;
      text-decoration: none;
    }
  }

  @media (max-width: 600px) {
    .site-contact-inner { min-height: 34px; justify-content: center; font-size: 13px; }
    .site-contact-links { display: none; }
    .site-brand img { width: 42px; height: 42px; }
    .site-nav { min-height: 64px; }
  }
</style>
