---
const reasons = [
  {
    title: 'Sigortalı Taşımacılık',
    desc: 'Tüm eşyalarınız taşıma süreci boyunca sigorta kapsamında. Olası hasarlara karşı tam güvence.',
  },
  {
    title: 'Deneyimli Profesyonel Ekip',
    desc: 'Eğitimli, kadrolu personelimiz eşyalarınıza özenle yaklaşır. Her taşıma bir sanat eseri gibi.',
  },
  {
    title: 'Ücretsiz Keşif & Fiyat Teklifi',
    desc: 'WhatsApp veya telefon ile anında ücretsiz fiyat teklifi alın. Şeffaf fiyatlandırma, gizli maliyet yok.',
  },
  {
    title: 'Türkiye Geneli 81 İl',
    desc: "Şehir içi ve şehirler arası Türkiye'nin her köşesine hizmet veriyoruz. Mesafe engel değil.",
  },
  {
    title: 'Modern Araç Filosu',
    desc: 'Kapalı kasa, bakımlı araçlarımız ve profesyonel taşıma ekipmanlarımızla eşyalarınız güvende.',
  },
  {
    title: 'Zamanında Teslimat',
    desc: 'Söz verilen tarihte, dakik teslimat. Taşınma planınızı aksatmadan, hızlı ve güvenilir hizmet.',
  },
];
---

<section class="reasons-section" id="neden-biz" aria-labelledby="reasons-heading">
  <div class="reasons-inner">
    <div class="reasons-intro">
      <h2 id="reasons-heading">Neden Leventoğlu Nakliyat?</h2>
      <p>Müşterilerimizin bize güvenmesinin sebeplerini keşfedin.</p>
    </div>
    <div class="reasons-list">
      {reasons.map((reason) => (
        <article class="reason-item">
          <h3>{reason.title}</h3>
          <p>{reason.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .reasons-section {
    padding: clamp(5rem, 10vw, 9rem) var(--page-margin);
    color: var(--ink);
    background: var(--paper);
  }

  .reasons-inner { max-width: 1760px; margin-inline: auto; }

  .reasons-intro {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(12rem, 4fr);
    gap: 2rem;
    align-items: end;
    margin-bottom: 3.5rem;
  }

  .reasons-intro h2 {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.5rem);
    letter-spacing: -0.05em;
  }

  .reasons-intro p {
    max-width: 34ch;
    margin: 0 0 0.25rem;
    color: var(--ink-soft);
    font-size: 17px;
  }

  .reasons-list {
    columns: 2;
    column-gap: clamp(2.5rem, 8vw, 8rem);
  }

  .reason-item {
    display: inline-block;
    width: 100%;
    margin: 0 0 2.5rem;
    break-inside: avoid;
  }

  .reason-item h3 {
    margin: 0 0 0.65rem;
    color: var(--ink);
    font-size: 20px;
    font-weight: 650;
    letter-spacing: -0.025em;
  }

  .reason-item p { margin: 0; color: var(--ink-soft); font-size: 16px; }

  @media (max-width: 700px) {
    .reasons-intro { grid-template-columns: 1fr; gap: 0.8rem; margin-bottom: 2.5rem; }
    .reasons-list { columns: 1; }
    .reason-item { margin-bottom: 2rem; }
  }
</style>
